{
  "name": "branch-cleaner",
  "version": "1.0.0",
  "description": "Interactively surface local git branches that are safe to delete (merged/closed/stale PRs) and print a ready-to-paste git branch -D command.",
  "type": "module",
  "bin": {
    "branch-cleaner": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "cli",
    "branches",
    "cleanup",
    "gh"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.0",
  "devDependencies": {
    "chalk": "^6.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
